# Copy to .env and fill in. .env is never committed.
#   cp .env.example .env

# --- Model -------------------------------------------------------------------
# HuggingFace repo to serve. AWQ/GPTQ safetensors only — GGUF is not supported.
MODEL_ID=Qwen/Qwen3-4B-AWQ

# Name clients put in the "model" field. Swap MODEL_ID freely, keep this stable.
MODEL_ALIAS=chat

# Only needed for gated repos (e.g. meta-llama/*).
HF_TOKEN=

# --- Auth --------------------------------------------------------------------
# Shared secret for the vLLM API. Generate: openssl rand -hex 32
VLLM_API_KEY=

# --- VRAM --------------------------------------------------------------------
# Fraction of TOTAL VRAM for weights + KV cache. Lower it if the GPU is shared.
GPU_MEM_UTIL=0.90

# Context window. Biggest VRAM knob — lower this first on CUDA OOM.
MAX_MODEL_LEN=8192

# Requests batched concurrently; the rest queue.
MAX_NUM_SEQS=64

# --- Paths -------------------------------------------------------------------
# HuggingFace cache on the host. Forward slashes, literal path (not ${HOME}).
HF_CACHE_DIR=C:/Users/<user>/.cache/huggingface

# --- Network -----------------------------------------------------------------
# Interface the ports bind to. 0.0.0.0 exposes them to the whole network.
BIND_ADDR=127.0.0.1
WEBUI_BIND_ADDR=127.0.0.1
